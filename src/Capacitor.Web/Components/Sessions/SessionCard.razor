@namespace Capacitor.Web.Components.Sessions

<a class="session-card-link" href="@($"/sessions/{Uri.EscapeDataString(Session.SessionId)}")">
    <article class="@CardClass" aria-current="@(IsSelected ? "page" : null)">
        <div class="session-card-heading">
            <span class="status-dot @StatusClass" aria-label="@($"{DisplayStatus} session")"></span>
            <span class="session-title">@DisplayTitle</span>
            @if (Session.StartedAt is { } startedAt) {
                <span class="muted session-started">@RelativeTime(startedAt)</span>
            }
        </div>

        <div class="session-identifiers">
            <span>@Session.Repository</span>
            @if (Session.PrNumber is { } prNumber) {
                <span class="session-chip">PR #@prNumber</span>
            }
            @if (!string.IsNullOrWhiteSpace(Session.Vendor)) {
                <span class="session-chip">@Session.Vendor</span>
            }
            @if (!string.IsNullOrWhiteSpace(Session.Model)) {
                <span class="session-chip">@Session.Model</span>
            }
        </div>

        <div class="session-metrics">
            <span>@TokenFlow</span>
            <span>@Session.ToolCount.ToString("N0") tool@(Session.ToolCount == 1 ? string.Empty : "s")</span>
        </div>
    </article>
</a>

@code {
    [Parameter, EditorRequired]
    public SessionSummary Session { get; set; } = default!;

    [Parameter]
    public bool IsSelected { get; set; }

    string DisplayTitle => string.IsNullOrWhiteSpace(Session.Title) ? "Untitled session" : Session.Title;
    string DisplayStatus => string.IsNullOrWhiteSpace(Session.Status) ? "unknown" : Session.Status;
    string StatusClass => $"status-{DisplayStatus.ToLowerInvariant()}";
    string TokenFlow => Session.TotalTokens > 0 ? $"{Compact(Session.TotalTokens)} total" : "Not reported";
    string CardClass => IsSelected ? "session-card session-card-selected" : "session-card";

    static string Compact(long value) => value switch {
        >= 1_000_000 => $"{value / 1_000_000d:0.#}M",
        >= 1_000 => $"{value / 1_000d:0.#}k",
        _ => value.ToString("N0")
    };

    static string RelativeTime(DateTimeOffset value) {
        var elapsed = DateTimeOffset.UtcNow - value;
        return elapsed switch {
            { TotalMinutes: < 1 } => "just now",
            { TotalHours: < 1 } => $"{Math.Floor(elapsed.TotalMinutes)}m ago",
            { TotalDays: < 1 } => $"{Math.Floor(elapsed.TotalHours)}h ago",
            _ => $"{Math.Floor(elapsed.TotalDays)}d ago"
        };
    }
}
