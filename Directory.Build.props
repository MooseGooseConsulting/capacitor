<Project>
    <PropertyGroup>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- Only on for IDE0005, which the compiler reports nowhere else. We ship no XML docs, so
             the doc-markup warnings it drags in are suppressed below; worth revisiting later. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>
            IDE0055<!-- Fix formatting -->;
            IDE1006<!-- Naming rule violation -->;
            CS1591<!-- Missing XML comment -->;
            CS1573<!-- Parameter has no matching param tag -->;
            CS1574<!-- cref attribute could not be resolved -->;
            CS0419<!-- Ambiguous reference in cref attribute -->;
            CS1734<!-- paramref tag with no matching parameter -->;
            CS1570<!-- Badly formed XML in comment -->;
        </NoWarn>
        <!-- CS8509: a switch expression that does not cover every named enum value. An error, not a
             warning, because the alternative to exhaustiveness is a discard arm, and a discard that
             maps to the permissive outcome makes the safe direction of a fail-closed gate whatever
             nobody thought about. The reviewer version gate shipped exactly that bug. Measured before
             enabling: zero CS8509 warnings across the daemon, Core, the CLI and the unit tests. -->
        <WarningsAsErrors>$(WarningsAsErrors);CS8509;IDE0005</WarningsAsErrors>
        <MinVerTagPrefix>v</MinVerTagPrefix>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="MinVer" PrivateAssets="All" />
    </ItemGroup>
</Project>
